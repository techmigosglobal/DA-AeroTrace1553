<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TaskDialog</class>
 <widget class="QDialog" name="TaskDialog">
  <property name="windowTitle"><string>Tasks and automation</string></property>
  <property name="minimumSize"><size><width>850</width><height>650</height></size></property>
  <layout class="QVBoxLayout" name="layout">
   <item><widget class="QLabel" name="heading"><property name="text"><string>Tasks and automation</string></property><property name="tone" stdset="0"><string>title</string></property></widget></item>
   <item><widget class="QLabel" name="scope"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Save a setup, configure synthetic traffic and checks, or analyze recordings. Apply configuration while capture is stopped.</string></property></widget></item>
   <item><widget class="QTabWidget" name="tabs">
    <widget class="QWidget" name="workspaceTab"><attribute name="title"><string>Saved workspace</string></attribute><layout class="QVBoxLayout" name="workspaceLayout">
     <item><widget class="QLabel" name="workspaceHint"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Restore the approved ICD, capture source, enabled streams, simulator, checks, monitor filters and plot selection. Opening a workspace leaves capture stopped.</string></property></widget></item>
     <item><widget class="QLineEdit" name="taskName"><property name="placeholderText"><string>Workspace name</string></property><property name="accessibleName"><string>Workspace name</string></property></widget></item>
     <item><layout class="QHBoxLayout" name="workspaceButtons"><item><widget class="QPushButton" name="saveTask"><property name="text"><string>Save workspace…</string></property></widget></item><item><widget class="QPushButton" name="openTask"><property name="text"><string>Open workspace…</string></property></widget></item></layout></item>
     <item><widget class="QPushButton" name="clearTraces"><property name="text"><string>Clear added plot traces</string></property></widget></item>
     <item><spacer name="workspaceSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>200</height></size></property></spacer></item>
    </layout></widget>
    <widget class="QWidget" name="simulationTab"><attribute name="title"><string>Offline simulation</string></attribute><layout class="QVBoxLayout" name="simulationLayout">
     <item><widget class="QLabel" name="simulationHint"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Synthetic traffic only. ICD generation packs all matching signals into each message. Values are quantized or saturated to their fields; overlapping fields need separate profiles. Waveform controls apply to ICD generation.</string></property></widget></item>
     <item><widget class="QCheckBox" name="useSimulation"><property name="text"><string>Use offline simulator for the next capture</string></property></widget></item>
     <item><widget class="QCheckBox" name="useProfile"><property name="text"><string>Generate traffic from the approved ICD mappings</string></property></widget></item>
     <item><layout class="QFormLayout" name="simFields">
      <item row="0" column="0"><widget class="QLabel" name="waveLabel"><property name="text"><string>Waveform</string></property><property name="buddy"><cstring>wave</cstring></property></widget></item><item row="0" column="1"><widget class="QComboBox" name="wave"><item><property name="text"><string>sine</string></property></item><item><property name="text"><string>square</string></property></item><item><property name="text"><string>ramp</string></property></item><item><property name="text"><string>constant</string></property></item><item><property name="text"><string>noise</string></property></item></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="rateLabel"><property name="text"><string>Records / second</string></property><property name="buddy"><cstring>rate</cstring></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="rate"><property name="minimum"><number>1</number></property><property name="maximum"><number>100000</number></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="amplitudeLabel"><property name="text"><string>Amplitude (engineering units)</string></property><property name="buddy"><cstring>amplitude</cstring></property></widget></item><item row="2" column="1"><widget class="QDoubleSpinBox" name="amplitude"><property name="decimals"><number>6</number></property><property name="maximum"><double>1000000000000</double></property></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="offsetLabel"><property name="text"><string>Center (engineering units)</string></property><property name="buddy"><cstring>offset</cstring></property></widget></item><item row="3" column="1"><widget class="QDoubleSpinBox" name="offset"><property name="decimals"><number>6</number></property><property name="minimum"><double>-1000000000000</double></property><property name="maximum"><double>1000000000000</double></property></widget></item>
      <item row="4" column="0"><widget class="QLabel" name="frequencyLabel"><property name="text"><string>Frequency (Hz)</string></property><property name="buddy"><cstring>frequency</cstring></property></widget></item><item row="4" column="1"><widget class="QDoubleSpinBox" name="frequency"><property name="decimals"><number>4</number></property><property name="minimum"><double>0.0001</double></property><property name="maximum"><double>10000</double></property></widget></item>
      <item row="5" column="0"><widget class="QLabel" name="seedLabel"><property name="text"><string>Noise seed</string></property><property name="buddy"><cstring>seed</cstring></property></widget></item><item row="5" column="1"><widget class="QLineEdit" name="seed"/></item>
      <item row="6" column="0"><widget class="QLabel" name="dropLabel"><property name="text"><string>Drop every Nth record (0 = off)</string></property><property name="buddy"><cstring>dropEvery</cstring></property></widget></item><item row="6" column="1"><widget class="QSpinBox" name="dropEvery"><property name="maximum"><number>1000000</number></property></widget></item>
      <item row="7" column="0"><widget class="QLabel" name="flagLabel"><property name="text"><string>Flag every Nth record (0 = off)</string></property><property name="buddy"><cstring>flagEvery</cstring></property></widget></item><item row="7" column="1"><widget class="QSpinBox" name="flagEvery"><property name="maximum"><number>1000000</number></property></widget></item>
     </layout></item>
    </layout></widget>
    <widget class="QWidget" name="checksTab"><attribute name="title"><string>Signal checks</string></attribute><layout class="QVBoxLayout" name="checksLayout">
     <item><widget class="QLabel" name="checksHint"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Blank limits disable that bound; 0 ms disables the missing-signal check. Checks use engineering values on each matching stream. Protocol flags, status bits and clock resets are also logged. Missing timers begin after a stream is first observed.</string></property></widget></item>
     <item><widget class="QTableWidget" name="checks"><property name="columnCount"><number>5</number></property><column><property name="text"><string>Signal</string></property></column><column><property name="text"><string>Minimum</string></property></column><column><property name="text"><string>Maximum</string></property></column><column><property name="text"><string>Missing (ms)</string></property></column><column><property name="text"><string>Hysteresis</string></property></column></widget></item>
     <item><layout class="QHBoxLayout" name="checkButtons"><item><widget class="QPushButton" name="addCheck"><property name="text"><string>Add check</string></property></widget></item><item><widget class="QPushButton" name="removeCheck"><property name="text"><string>Remove selected</string></property></widget></item></layout></item>
    </layout></widget>
    <widget class="QWidget" name="batchTab"><attribute name="title"><string>Batch analysis</string></attribute><layout class="QVBoxLayout" name="batchLayout">
     <item><widget class="QLabel" name="batchHint"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Apply the currently approved ICD and applied checks to 1–100 ATD2 recordings, up to 32 MiB each. Produces engineering CSVs, signal statistics, check events, integrity results and hashes in a new output folder. Recording sidecar profiles are not applied.</string></property></widget></item>
     <item><widget class="QListWidget" name="batchFiles"><property name="accessibleName"><string>Batch input recordings</string></property></widget></item>
     <item><layout class="QHBoxLayout" name="fileButtons"><item><widget class="QPushButton" name="chooseFiles"><property name="text"><string>Choose recordings…</string></property></widget></item><item><widget class="QPushButton" name="outputFolder"><property name="text"><string>Output folder…</string></property></widget></item></layout></item>
     <item><widget class="QLineEdit" name="batchOutput"><property name="readOnly"><bool>true</bool></property><property name="accessibleName"><string>Batch output folder</string></property></widget></item>
     <item><widget class="QProgressBar" name="batchProgress"/></item>
     <item><layout class="QHBoxLayout" name="runButtons"><item><widget class="QPushButton" name="runBatch"><property name="text"><string>Analyze and report</string></property><property name="primary" stdset="0"><bool>true</bool></property></widget></item><item><widget class="QPushButton" name="cancelBatch"><property name="text"><string>Cancel batch</string></property></widget></item><item><widget class="QPushButton" name="openReport"><property name="text"><string>Open report folder</string></property></widget></item></layout></item>
    </layout></widget>
   </widget></item>
   <item><widget class="QLabel" name="status"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Ready</string></property></widget></item>
   <item><layout class="QHBoxLayout" name="footer"><item><widget class="QPushButton" name="apply"><property name="text"><string>Apply simulation and checks</string></property></widget></item><item><widget class="QPushButton" name="close"><property name="text"><string>Close</string></property></widget></item></layout></item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
