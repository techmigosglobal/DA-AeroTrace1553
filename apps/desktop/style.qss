QWidget {font-family:'Segoe UI';font-size:15px;color:#162836;}
QMainWindow,QWidget#workspace,QWidget#centralWidget {background:#f3f7fb;}
QFrame#sidebar {
  background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #edf5f6,stop:1 #e9f1f7);
  border:0;
}
QWidget#navigation,QWidget#secondaryNavigation {background:transparent;border:0;}
QFrame#sidebar {border-right:1px solid #ccdae4;}
QFrame#header {background:#f7fafd;border:0;border-bottom:1px solid #d7e2ea;}
QLabel {background:transparent;border:0;}
QLabel#headerTitle {font-size:28px;font-weight:700;color:#071623;}
QLabel[tone="title"],QLabel#title {font-size:25px;font-weight:700;}
QLabel[tone="metric"],QLabel#metric {font-size:28px;font-weight:650;}
QLabel[tone="muted"],QLabel#muted {font-size:13px;color:#6b7169;}
QLabel[tone="cardtitle"],QLabel#cardtitle {font-size:16px;font-weight:600;}
QFrame[card="true"],QFrame#card {background:#fbfdff;border:1px solid #d1dee8;border-radius:10px;}
QLabel[tone="notice"],QLabel#notice {background:#f3f5f0;border:1px solid #dcded8;border-radius:4px;padding:10px;color:#596359;font-size:13px;}
QLabel[tone="warning"],QLabel#warning {background:#faf4e8;border:1px solid #dfccaa;border-radius:4px;padding:10px;color:#875b1f;font-size:13px;}
QLabel[tone="success"],QLabel#success {background:#eef5ef;border:1px solid #ccdece;border-radius:4px;padding:10px;color:#28624d;font-size:13px;}
QLabel#error {background:#fcf0ed;border:1px solid #e5b7ae;color:#a73d32;border-radius:4px;padding:10px;}
QLabel#group {font-size:12px;color:#737970;padding:8px;}
QPushButton,QToolButton {background:#fbfdff;border:1px solid #c9d7e3;border-radius:7px;padding:8px 12px;font-size:14px;font-weight:500;color:#172b3a;min-height:20px;}
QPushButton:hover,QToolButton:hover {background:#eaf3f1;border-color:#94b8ad;}
QPushButton:pressed {background:#dce8db;}
QPushButton:checked {background:#e1ece1;border-color:#729477;color:#234f39;}
QPushButton:disabled {color:#92998f;background:#f1f2ee;border-color:#dfe2da;}
QPushButton[primary="true"],QPushButton#primary,QPushButton#globalCaptureButton {background:#266149;color:#ffffff;border-color:#266149;}
QPushButton[primary="true"]:hover,QPushButton#primary:hover,QPushButton#globalCaptureButton:hover {background:#1c4d38;}
QPushButton#danger {background:#a9473d;color:white;border-color:#a9473d;}
QPushButton[navigation="true"] {text-align:left;background:transparent;border:0;border-radius:4px;padding:11px 10px;min-height:23px;font-size:15px;font-weight:400;}
QPushButton[navigation="true"]:checked {background:#dfeadf;color:#234d36;font-weight:600;}
QPushButton[navigation="true"]:hover {background:#e6e9e1;}
QPushButton[navigation="true"][collapsed="true"] {padding:11px 7px;text-align:center;}
QPushButton#sidebarToggle {border:0;background:transparent;padding:5px;min-width:22px;}
QPushButton#moreTools {text-align:left;background:transparent;border:0;padding:11px 10px;font-size:15px;}
QPushButton#preferencesButton {padding:7px;border:0;background:transparent;}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox,QPlainTextEdit,QTextEdit {background:white;border:1px solid #d0d5cd;border-radius:4px;padding:8px;color:#2f392f;min-height:20px;selection-background-color:#dfeadf;selection-color:#203b28;}
QComboBox::drop-down {border:0;width:24px;}
QTableView {background:#ffffff;alternate-background-color:#fafbf8;gridline-color:#e7eae3;border:1px solid #dcded8;border-radius:3px;selection-background-color:#e0eee0;selection-color:#233c29;font-size:14px;outline:none;}
QTableView::item {padding:6px;border:0;border-bottom:1px solid #e9ece5;}
QTreeView {background:#ffffff;alternate-background-color:#fafbf8;border:1px solid #dcded8;selection-background-color:#e0eee0;selection-color:#233c29;font-size:14px;outline:none;}
QTreeView::item {padding:6px;border:0;border-bottom:1px solid #e9ece5;}
QHeaderView::section {background:#eff1ec;color:#3e483e;border:0;border-right:1px solid #dfe3da;border-bottom:1px solid #d5dcd0;padding:9px 6px;font-size:12px;font-weight:600;}
QTabBar::tab {background:#f3f3f0;border:0;border-bottom:3px solid #dcded8;padding:10px 22px;font-size:15px;min-height:20px;color:#5b6558;}
QTabBar::tab:selected {background:white;color:#253d2c;border-bottom:3px solid #3f7651;font-weight:600;}
QScrollArea {border:0;background:transparent;}
QScrollBar:vertical {background:#edf3f7;width:9px;}
QScrollBar::handle:vertical {background:#aebec9;min-height:32px;border-radius:4px;}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical {height:0;}
QScrollBar:horizontal {background:#edefe8;height:10px;}
QScrollBar::handle:horizontal {background:#b4bfad;min-width:36px;border-radius:4px;}
QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal {width:0;}
QCheckBox {spacing:8px;padding:7px 0;}
QCheckBox::indicator {width:18px;height:18px;border:1px solid #a8b1a0;border-radius:3px;background:#ffffff;}
QCheckBox::indicator:checked {background:#3f7651;border-color:#3f7651;image:url(:/icons/check.svg); }
QSlider::groove:horizontal {height:7px;background:#dfe4d9;border-radius:3px;}
QSlider::sub-page:horizontal {background:#477453;}
QSlider::handle:horizontal {width:16px;background:#315b3e;border-radius:4px;margin:-4px 0;}
QToolTip,QMenu {background:#ffffff;color:#28342c;border:1px solid #c7d0bf;padding:6px;font-size:14px;}
QMenu::item {padding:8px 18px;}
QMenu::item:selected {background:#e2ecdc;}
QGroupBox {background:white;border:1px solid #dcded8;border-radius:5px;margin-top:12px;padding:28px 16px 16px;font-size:16px;font-weight:600;}
QGroupBox::title {subcontrol-origin:margin;left:12px;padding:2px 5px;}
QStatusBar {background:#f0f2ec;border-top:1px solid #dcded8;font-size:13px;}
QStatusBar QLabel {font-size:12px;color:#34453a;}
QPushButton:focus,QToolButton:focus,QLineEdit:focus,QComboBox:focus,QPlainTextEdit:focus,QTableView:focus,QTreeView:focus {border:2px solid #245c46;}
QPushButton[primary="true"]:disabled,QPushButton#globalCaptureButton:disabled {color:#5b655b;background:#e6ebe4;border-color:#c6d0c5;}

/* Approved 0.5 workspace surfaces */
QPushButton[navigation="true"]:checked {background:#176043;color:#ffffff;font-weight:600;}
QMdiArea {border:1px solid #d8ddda;}
QMdiSubWindow {background:#ffffff;border:1px solid #cbd3ce;}
QGroupBox {background:#ffffff;border:1px solid #dcded8;border-radius:4px;margin-top:12px;padding-top:14px;font-weight:600;}
QGroupBox::title {subcontrol-origin:margin;left:10px;padding:0 4px;}

/* Focused workspace polish: Welcome, Device setup, RT Dashboard, Monitor. */
QWidget[workspacePolish="true"] {background:#f2f6fa;}
QWidget[workspacePolish="true"] QLabel {background:transparent;color:#24364b;}
QWidget[workspacePolish="true"] QLabel[tone="muted"] {color:#53677d;}
QWidget[workspacePolish="true"] QLabel[tone="cardtitle"] {font-size:17px;font-weight:600;color:#153b59;}
QWidget[workspacePolish="true"] QFrame[card="true"] {background:#ffffff;border:1px solid #ccd9e5;border-radius:8px;}
QWidget[workspacePolish="true"] QLabel[tone="notice"] {background:#e9f2f8;border:1px solid #bed1e0;color:#315670;border-radius:6px;padding:12px;}
QWidget[workspacePolish="true"] QPushButton {background:#ffffff;border:1px solid #a9bacb;color:#29445f;border-radius:5px;}
QWidget[workspacePolish="true"] QPushButton:hover {background:#eaf3fa;border-color:#4c83aa;}
QWidget[workspacePolish="true"] QPushButton:pressed {background:#d7e8f4;border-color:#285f8d;}
QWidget[workspacePolish="true"] QPushButton:focus {border:2px solid #176d85;background:#edf7fb;}
QWidget[workspacePolish="true"] QPushButton[primary="true"] {background:#146b63;border-color:#146b63;color:#ffffff;}
QWidget[workspacePolish="true"] QPushButton[primary="true"]:hover {background:#0e574f;border-color:#0e574f;}
QWidget[workspacePolish="true"] QPushButton[primary="true"]:pressed {background:#0b463f;}
QWidget[workspacePolish="true"] QPushButton[primary="true"]:focus {background:#0e574f;border:2px solid #153b59;}
QWidget[workspacePolish="true"] QPushButton:disabled {background:#edf1f5;color:#66788a;border-color:#ccd6e0;}
QWidget[workspacePolish="true"] QLineEdit,QWidget[workspacePolish="true"] QComboBox,QWidget[workspacePolish="true"] QSpinBox {background:#ffffff;border:1px solid #90a5ba;color:#24364b;}
QWidget[workspacePolish="true"] QLineEdit:focus,QWidget[workspacePolish="true"] QComboBox:focus,QWidget[workspacePolish="true"] QSpinBox:focus {border:2px solid #176d85;background:#f7fcff;}
QWidget[workspacePolish="true"] QFrame[channelRole="external"],QWidget[workspacePolish="true"] QGroupBox[channelRole="external"],QWidget[workspacePolish="true"] QFrame#deviceState0 {background:#f5faff;border:1px solid #b6cce5;border-top:3px solid #245fa8;border-radius:6px;}
QWidget[workspacePolish="true"] QFrame[channelRole="internal"],QWidget[workspacePolish="true"] QGroupBox[channelRole="internal"],QWidget[workspacePolish="true"] QFrame#deviceState1 {background:#faf7ff;border:1px solid #d5c6e5;border-top:3px solid #7445a5;border-radius:6px;}
QWidget[workspacePolish="true"] QTableView {background:#ffffff;alternate-background-color:#f5f8fc;border:1px solid #ccd9e5;selection-background-color:#d5eee9;selection-color:#153b45;}
QWidget[workspacePolish="true"] QTableView::item:hover {background:#eaf3fa;}
QWidget[workspacePolish="true"] QHeaderView::section {background:#e7eff7;color:#2d4b68;border-color:#ccd9e5;}
QWidget[workspacePolish="true"] QTabBar::tab {background:#eaf0f6;color:#405b76;border-bottom:3px solid #ccd9e5;}
QWidget[workspacePolish="true"] QTabBar::tab:selected {background:#ffffff;color:#115b55;border-bottom:3px solid #146b63;}
QWidget[workspacePolish="true"] QFrame[rtIndex] {background:#ffffff;border:1px solid #ccd9e5;}
QWidget[workspacePolish="true"] QFrame[observedRt="true"] {background:#f0faf4;border-color:#95c6a8;}
QWidget[workspacePolish="true"] QFrame[selectedRt="true"] {background:#eaf3fa;border:2px solid #245fa8;}
QWidget[workspacePolish="true"] QPushButton[rtSelector="true"] {text-align:left;background:transparent;border:1px solid transparent;padding:2px;font-size:15px;font-weight:600;}
QWidget[workspacePolish="true"] QPushButton[rtSelector="true"]:hover {background:#e0edf7;border-color:#aac5dc;}
QWidget[workspacePolish="true"] QPushButton[rtSelector="true"]:focus {border:2px solid #245fa8;}

QWidget#workspace[workspacePolish="true"] {background:#f2f6fa;}
QWidget[workspacePolish="true"] QPushButton:checked {background:#d5eee9;border-color:#4b918a;color:#134e4a;}

QWidget[workspacePolish="true"] QComboBox::down-arrow {image:url(:/icons/chevron-down.svg);width:14px;height:14px;}
QWidget[workspacePolish="true"] QSpinBox::up-button {subcontrol-origin:border;subcontrol-position:top right;width:24px;border-left:1px solid #b5c6d8;background:#edf3f9;}
QWidget[workspacePolish="true"] QSpinBox::down-button {subcontrol-origin:border;subcontrol-position:bottom right;width:24px;border-left:1px solid #b5c6d8;background:#edf3f9;}
QWidget[workspacePolish="true"] QSpinBox::up-arrow {image:url(:/icons/chevron-up.svg);width:12px;height:12px;}
QWidget[workspacePolish="true"] QSpinBox::down-arrow {image:url(:/icons/chevron-down.svg);width:12px;height:12px;}

QPushButton[rtSelector="true"]:hover {background:#eaf3fa;}
QPushButton[rtSelector="true"]:focus {border:2px solid #245fa8;}

/* Subsystem Workspace: shared context, restrained evidence and action surfaces. */
QFrame#subsystemPanel {background:#e8efe9;border:1px solid #d2ddd3;border-radius:7px;}
QLabel#workspaceTitle {font-size:18px;font-weight:600;color:#214d3b;}
QLabel#workspaceScope {color:#526a5c;padding:5px 0;}
QLabel#workspaceRoute {padding:10px;background:#f6f9f4;border-radius:4px;color:#405f4c;}
QTreeWidget#subsystemList {background:transparent;border:0;outline:none;}
QTreeWidget#subsystemList::item {padding:12px 5px;margin:3px 0;border:1px solid #d6e0d5;border-radius:5px;background:#f9fbf8;}
QTreeWidget#subsystemList::item:selected {background:#d8e9dc;border-color:#83ac8d;color:#1c4d35;}
QTextBrowser#answer {background:#fbfdfb;border:1px solid #d5dfd5;border-radius:6px;padding:10px;}
QToolButton {padding:7px;border:1px solid transparent;border-radius:4px;color:#28553f;}
QToolButton:hover {background:#e5eee4;border-color:#adbfaa;}
QToolButton:focus {border:2px solid #346449;}

/* AeroTrace operator shell and shared compact controls. */
QFrame#sidebar {
  background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f5faf8,stop:1 #e5f1ec);
  border-right:1px solid #d4e2dc;
}
QWidget#brand {
  background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #1a6b49,stop:1 #0d5034);
  border-radius:10px;
}
QLabel#brandText {font-size:17px;font-weight:700;color:#ffffff;}
QLabel#brandSubtitle {font-size:12px;color:#d6eee3;}
QLabel#headerSubtitle {font-size:14px;color:#4a6070;}
QLabel#sidebarWave {display:none;}
QLabel#sidebarBrandCaption {font-size:13px;color:#172d3e;border-left:0;padding-left:4px;}
QWidget#sidebarFooter {background:transparent;}
QPushButton[navigation="true"],QPushButton#moreTools {border:1px solid transparent;border-radius:8px;padding:7px 10px;min-height:20px;font-size:14px;color:#172d3e;}
QPushButton[navigation="true"]:checked {
  color:white;font-weight:600;
  background:#146343;
}
QPushButton[navigation="true"]:hover:!checked,QPushButton#moreTools:hover {background:#dfeee7;}
QPushButton[navigation="true"]:focus,QPushButton#moreTools:focus {border:1px solid #377bb0;}
QPushButton[navigation="true"][collapsed="true"],QPushButton#moreTools[collapsed="true"] {padding:9px 1px;text-align:center;}
QPushButton#sidebarToggle {
  background:#ffffff;border:1px solid #d0dde5;border-radius:12px;
  min-width:24px;max-width:24px;min-height:24px;max-height:24px;padding:2px;
}
QPushButton#sidebarToggle:hover {background:#eef6f2;}
QWidget#secondaryNavigation QPushButton {font-size:14px;padding-top:6px;padding-bottom:6px;}
QPushButton#alertsButton,QPushButton#preferencesButton {padding:7px;background:transparent;border:1px solid transparent;}
QPushButton#alertsButton:hover,QPushButton#preferencesButton:hover {background:#e8f1f5;border:1px solid #ccdce7;}
QPushButton#alertsButton:focus,QPushButton#preferencesButton:focus,QPushButton#sidebarToggle:focus {border:1px solid #377bb0;}
QPushButton[primary="true"]:enabled,QPushButton#globalCaptureButton:enabled {
  border-color:#0d5538;color:white;
  background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #247951,stop:1 #0d5438);
}
QPushButton[primary="true"]:hover,QPushButton#globalCaptureButton:hover {background:#10563a;}
QPushButton[primary="true"]:focus,QPushButton#globalCaptureButton:focus {border-color:#367db7;}
QPushButton[primary="true"]:disabled,QPushButton#globalCaptureButton:disabled {color:#647988;background:#e9eff3;border:1px solid #d5e1e9;}
QWidget#assistantPage,QWidget#workspaceStack {background:#f3f7fb;}
/* The operator shell gives Monitor & Record and Live Plot Analysis the
   largest continuous surfaces. Retired destinations remain source-compatible
   for the regression harness but are never presented in the sidebar/header. */
QPushButton#icdChatButton,QPushButton#alertsButton,QPushButton#assistantNavigation,
QPushButton#nav5,QPushButton#nav8,QPushButton#nav9,QPushButton#nav15 {display:none;}
QFrame#recordingSetup[card="true"] {background:#ffffff;border:1px solid #ccd9e5;border-radius:8px;}
QWidget#plotSurface {min-height:240px;}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox {background:#fbfdff;border:1px solid #b8cbd9;border-radius:6px;color:#172b3a;padding:6px 8px;}
QComboBox::down-arrow {image:url(:/icons/chevron-down.svg);width:13px;height:13px;}
QTableView {background:#fbfdff;alternate-background-color:#f6f9fb;gridline-color:#dce6ee;border:1px solid #d2dee8;border-radius:7px;selection-background-color:#e0f0e5;selection-color:#15352c;}
QHeaderView {background:#e8f0f4;border:0;}
QHeaderView::section {background:#e8f0f4;color:#20394c;border-color:#d4e0e9;font-size:13px;}
QTabBar::tab {background:transparent;color:#2f485b;border-bottom:2px solid #d6e2eb;}
QTabBar::tab:selected {color:#145638;border-bottom:3px solid #125d3d;}
QFrame#deviceState0 {background:#f1f8f4;border-color:#c5ded0;}
QFrame#deviceState1 {background:#eff6fc;border-color:#c6daed;}
QLabel[channelBadge="true"] {background:#eaf1f6;border:1px solid #d6e2ea;border-radius:14px;padding:5px 9px;font-size:12px;color:#244358;}
QLabel[statusDot="true"] {background:transparent;}
QFrame#subsystemPanel {background:#f1f6fa;border-color:#d3e0e9;border-radius:11px;}
QWidget#workspaceBody {background:#f9fbfd;border:1px solid #d3e0e9;border-radius:10px;}
QTreeWidget#subsystemList::item {background:#f9fcfe;border-color:#d8e4ec;border-radius:7px;color:#20364a;}
QTreeWidget#subsystemList::item:selected {background:#e0f1e6;border-color:#6da88b;color:#153a2b;}
QLabel[pill="profile"] {background:#e1f0e8;color:#134831;border-radius:12px;padding:4px 9px;font-size:12px;}
QLabel[pill="scope"] {background:#e9f0f7;color:#254963;border-radius:12px;padding:4px 9px;font-size:12px;}
QLabel[noticeTitle="true"] {font-size:17px;font-weight:600;color:#172f41;}
QLabel[noticeCopy="true"] {color:#3e5a70;font-size:14px;}
QFrame[sectionHeading="true"] {background:#e9f4ef;border:0;border-radius:8px;}
QFrame[sectionHeading="blue"] {background:#e8f1fb;border:0;border-radius:8px;}
QLabel[sectionTitle="true"] {font-size:20px;font-weight:650;color:#0e2230;}
QLabel[fixedValue="true"] {background:#eef4f8;border:0;border-radius:6px;color:#214158;padding:6px 10px;font-weight:600;}
QSpinBox,QDoubleSpinBox {background:#ffffff;border:1px solid #c6d6e2;border-radius:6px;padding:4px 6px;min-height:24px;color:#0e2230;}
QSpinBox:hover,QDoubleSpinBox:hover {border-color:#5b8fb9;}
QSpinBox:focus,QDoubleSpinBox:focus {border-color:#0f766e;}
QFrame#workflowStepper {background:#f4f8fb;border:1px solid #d5e2eb;border-radius:8px;}
QPushButton[stepButton="true"] {background:transparent;border:1px solid transparent;border-radius:6px;padding:3px 9px;font-weight:600;color:#47637a;text-align:left;}
QPushButton[stepButton="true"]:hover {background:#e7f0f6;color:#143045;}
QPushButton[stepButton="true"][stepState="current"] {background:#125b78;color:#ffffff;border-color:#0e4c65;}
QPushButton[stepButton="true"][stepState="done"] {background:#e4f3ec;color:#12593a;border-color:#b7decb;}
QPushButton#signalPillButton {background:#e6f1fa;border:1px solid #b8d3ea;border-radius:12px;padding:4px 11px;color:#13456b;font-weight:600;font-size:12px;}
QPushButton#signalPillButton:hover {background:#d6e8f7;}
QFrame#postSaveBanner {background:#e6f4ed;border:1px solid #9bd1b5;border-radius:8px;}
QTabBar#subWorkspaceTabs::tab {background:#ffffff;border:1px solid #cfdde7;border-radius:8px;padding:8px 16px;margin-right:6px;font-weight:600;font-size:14px;color:#2c4b62;}
QTabBar#subWorkspaceTabs::tab:selected {background:#146343;color:#ffffff;border-color:#146343;}
#analysisToolbar QToolButton {padding:4px;border:1px solid #cddae4;border-radius:7px;background:#ffffff;color:#172b3a;}
#analysisToolbar QToolButton:hover {background:#eef4f8;}
#analysisToolbar QToolButton:checked {background:#e2f3e8;color:#145331;border-color:#8ac7a6;}
QGroupBox[channelRole="external"] {background:#eff6fe;border:1px solid #8eb7e8;border-radius:8px;}
QGroupBox[channelRole="internal"] {background:#f5f1fc;border:1px solid #b6a0dc;border-radius:8px;}
QProgressBar[operatorBusy="true"] {background:#e5edf2;border:0;border-radius:3px;min-height:5px;max-height:5px;}
QProgressBar[operatorBusy="true"]::chunk {background:#1d8157;}

QLabel[deviceIcon="external"],QLabel[deviceIcon="internal"] {padding:9px;border-radius:9px;background:#e0f1e8;}
QLabel[deviceIcon="internal"] {background:#e0eef9;}
QLabel#deviceTitle0,QLabel#deviceTitle1 {font-size:16px;font-weight:700;color:#142d3a;}
QLabel#deviceStatus0,QLabel#deviceStatus1 {font-size:13px;}
QLabel[checkName="true"] {font-weight:600;color:#173146;}
QLabel#recordingOutputs {font-size:13px;color:#203c51;}
QFrame#connectionResultPanel QPushButton {padding:6px 8px;font-size:13px;}
QFrame#sidebarRule {background:#c9dce4;border:0;}
QWidget#PreferencesPage QFrame[card="true"] {border-radius:11px;}
QWidget#PreferencesPage QCheckBox {padding:3px 0;}
QWidget#PreferencesPage QPushButton#saveButton {padding-left:15px;padding-right:15px;}
QWidget#PreferencesPage QFrame[sectionHeading] {min-height:52px;}

/* Monitor & Record side-by-side channel windows */
QMdiArea#monitorWorkspace {background:#f3f7fb;border:0;}
QMdiSubWindow {background:#ffffff;border:1px solid #b8d2c7;border-radius:10px;}
QMdiSubWindow::title {background:#eaf5f0;border-bottom:1px solid #d4e6dd;height:32px;padding:4px 8px;}
QFrame[channelRole="external"],QFrame[channelRole="internal"] {background:#ffffff;border:0;}
QLabel#paneCount0,QLabel#paneCount1 {font-size:13px;color:#243b4d;}
QFrame#scopeFooter {background:#f7faf9;border-top:1px solid #e4ece8;border-radius:0;}
QLabel#scopeNotice {font-size:12px;color:#3a5264;}
QWidget#actionBar QPushButton,QWidget#actionBar QComboBox,
QComboBox#monitorRowMode,QPushButton#monitorRtMatrixToggle,QPushButton#pauseRtDisplay {
  background:#ffffff;border:1px solid #cddae4;border-radius:8px;padding:5px 9px;font-size:13px;color:#172b3a;
}
QPushButton#startRecordingButton {border-radius:8px;padding:7px 14px;font-weight:600;}
