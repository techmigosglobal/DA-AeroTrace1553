foreach(kind asan ubsan)
  execute_process(COMMAND "${CANARY}" "${kind}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
  if(result STREQUAL "0")
    message(FATAL_ERROR "${kind} canary was not detected")
  endif()
  if(kind STREQUAL "asan" AND NOT "${out}${err}" MATCHES "AddressSanitizer")
    message(FATAL_ERROR "ASan runtime missing or failed to report: ${out}${err}")
  endif()
  if(kind STREQUAL "ubsan" AND NOT "${out}${err}" MATCHES "runtime error: signed integer overflow")
    message(FATAL_ERROR "UBSan runtime missing or failed to report: ${out}${err}")
  endif()
endforeach()
