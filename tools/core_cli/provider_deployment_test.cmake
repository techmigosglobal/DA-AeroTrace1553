string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(destination "${OUTPUT_ROOT}/provider-deployment-${suffix}")
file(MAKE_DIRECTORY "${destination}")
file(COPY "${INSPECTOR}" DESTINATION "${destination}")
get_filename_component(name "${INSPECTOR}" NAME)
function(inspect expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=AEROTRACE_DDC_PROVIDER
    "${destination}/${name}" "${RUNTIME}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
  if(expected STREQUAL "PASS")
    if(NOT result EQUAL 0 OR NOT output MATCHES "PASS:")
      message(FATAL_ERROR "Expected available provider: ${result}; ${output}; ${errors}")
    endif()
  elseif(result EQUAL 0 OR NOT output MATCHES "Provider required")
    message(FATAL_ERROR "Deployed provider unexpectedly fell back to developer files: ${result}; ${output}; ${errors}")
  endif()
endfunction()
inspect(PASS)
file(WRITE "${destination}/deployment.json" "{\"developmentFallbacks\":false}\n")
inspect(BLOCKED)
file(MAKE_DIRECTORY "${destination}/providers")
file(COPY "${PROVIDER}" DESTINATION "${destination}/providers")
inspect(PASS)
message(STATUS "Deployment marker requires the bundled provider; developer fallback remains available only to source builds")
