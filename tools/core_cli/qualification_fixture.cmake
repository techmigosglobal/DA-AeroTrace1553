if(NOT DEFINED QUALIFIER OR NOT DEFINED RUNTIME OR NOT DEFINED OUTPUT_ROOT)
  message(FATAL_ERROR "Qualifier, test-only runtime and output root are required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_suffix)
set(evidence "${OUTPUT_ROOT}/qualification-${run_suffix}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env AEROTRACE_TEST_DDC_BOTH_BUSES=1
  "${QUALIFIER}" --output "${evidence}" --runtime "${RUNTIME}" --seconds 1 --cycles 2 --source-label sdk-fixture
  RESULT_VARIABLE result OUTPUT_VARIABLE progress ERROR_VARIABLE errors TIMEOUT 15)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Qualification fixture failed: ${result}\n${progress}\n${errors}")
endif()
file(STRINGS "${evidence}/runs.jsonl" runs)
list(LENGTH runs run_count)
if(NOT run_count EQUAL 2)
  message(FATAL_ERROR "Repeated recording cycles were not preserved")
endif()
foreach(run IN LISTS runs)
  string(JSON verdict GET "${run}" verdict)
  string(JSON source GET "${run}" source)
  string(JSON connected GET "${run}" connected_after_stop)
  if(NOT verdict STREQUAL "capture_evidence_complete" OR NOT source STREQUAL "sdk-fixture" OR NOT connected)
    message(FATAL_ERROR "Incorrect evidence verdict/source/connection")
  endif()
  foreach(k RANGE 0 3)
    string(JSON count GET "${run}" streams ${k} records)
    string(JSON responded GET "${run}" streams ${k} valid_with_response)
    if(NOT count EQUAL 1 OR NOT responded EQUAL 1)
      message(FATAL_ERROR "Missing A/B stream or response evidence at stream ${k}")
    endif()
  endforeach()
endforeach()
# Existing evidence must remain protected on a repeated invocation.
execute_process(COMMAND "${QUALIFIER}" --output "${evidence}" --runtime "${RUNTIME}"
  RESULT_VARIABLE repeated OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
if(repeated EQUAL 0)
  message(FATAL_ERROR "Existing evidence was accepted for overwrite")
endif()
message(STATUS "Two cycles, four responding streams and evidence protection verified using SDK fixture: ${evidence}")
